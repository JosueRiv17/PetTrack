<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    tools:context=".InicioSesion">

    <ScrollView
        android:id="@+id/scrollInicioSesion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="32dp">

            <!-- 1. LOGO / ENCABEZADO -->
            <LinearLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:background="#FFF1E1"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ivLogoLogin"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/icon_usuario"
                    app:tint="#E58C52" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtNombreAppLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="@string/txtNombreApp"
                android:textColor="#2F3E38"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 2. TÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:letterSpacing="0.08"
                android:text="@string/txtBienvenidaLogin"
                android:textColor="#D67A3E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/txtTituloLogin"
                android:textColor="#1F2421"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/txtSubtituloLogin"
                android:textColor="#6E7772"
                android:textSize="15sp" />

            <!-- 3. FORMULARIO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/txtCorreo"
                android:textColor="#2F3E38"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="emailAddress"
                android:background="#FFFFFF"
                android:hint="@string/txtTransCorreo"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#1F2421"
                android:textColorHint="#9AA39E"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/txtContrasena"
                android:textColor="#2F3E38"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:background="#FFFFFF"
                android:hint="@string/txtTransContrasena"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="#1F2421"
                android:textColorHint="#9AA39E"
                android:textSize="14sp" />

            <!-- Recordarme / Olvidé contraseña -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbRecordarme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#355847"
                    android:text="@string/txtRecordarme"
                    android:textColor="#5C6B64"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtOlvideContrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/txtOlvideContrasena"
                    android:textColor="#B86B35"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. BOTÓN PRINCIPAL -->
            <Button
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#355847"
                android:text="@string/btnIniciarSesion"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="#E8ECE9" />

            <!-- 5. AVISO / REGISTRO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#EFF4EE"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/txtNoTienesCuenta"
                    android:src="@drawable/icon_usuario"
                    app:tint="#355847" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/txtNoTienesCuenta"
                    android:textColor="#55615A"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtRegistrarse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="@string/txtRegistrarse"
                    android:textColor="#B86B35"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/txtAvisoLogin"
                android:textColor="#8A928D"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
