<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainAgregar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    tools:context=".AgregarMascota">

    <ScrollView
        android:id="@+id/scrollAgregar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavAgregar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="UN NUEVO COMPAÑERO"
                android:textColor="#D67A3E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Agregar mascota"
                android:textColor="#1F2421"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Su historia de cuidado empieza aquí."
                android:textColor="#6E7772"
                android:textSize="15sp" />

            <!-- Bloque amplio de foto -->
            <LinearLayout
                android:id="@+id/contenedorFoto"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="24dp"
                android:background="#FFF1E1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/ivPreviewFoto"
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:contentDescription="Foto de la mascota"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon_camara"
                    app:tint="#8C6239" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Agrega su mejor foto"
                    android:textColor="#1F2421"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Opcional · JPG, PNG o WebP · Máx. 2 MB"
                    android:textColor="#7A827D"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Sección: Conozcamos a tu mascota -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Mascota"
                    android:src="@drawable/icon_usuario"
                    app:tint="#355847" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Conozcamos a tu mascota"
                    android:textColor="#1F2421"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nombre * -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nombre *"
                android:textColor="#2F3E38"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNombreMascota"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="¿Cómo se llama?"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="#1F2421"
                android:textColorHint="#9AA39E"
                android:textSize="14sp" />

            <!-- Raza -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Raza"
                android:textColor="#2F3E38"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRazaMascota"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Ej. Golden Retriever o mestizo"
                android:inputType="textCapSentences"
                android:paddingHorizontal="16dp"
                android:textColor="#1F2421"
                android:textColorHint="#9AA39E"
                android:textSize="14sp" />

            <!-- Año de nacimiento y Peso (kg) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Año de nacimiento"
                        android:textColor="#2F3E38"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etAnioNacimiento"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="#FFFFFF"
                        android:hint="Ej. 2023"
                        android:inputType="number"
                        android:maxLength="4"
                        android:paddingHorizontal="16dp"
                        android:textColor="#1F2421"
                        android:textColorHint="#9AA39E"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peso (kg)"
                        android:textColor="#2F3E38"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etPesoKg"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="#FFFFFF"
                        android:hint="Ej. 8.5"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="16dp"
                        android:textColor="#1F2421"
                        android:textColorHint="#9AA39E"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Esterilizado/a -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#EFF4EE"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Está esterilizado/a?"
                        android:textColor="#1F2421"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Un dato importante para su cuidado"
                        android:textColor="#6E7772"
                        android:textSize="12sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbEsterilizado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#355847" />
            </LinearLayout>

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="#E8ECE9" />

            <!-- Sección: Sus vacunas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sus vacunas"
                    android:textColor="#1F2421"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#ECE8FA"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Opcional"
                    android:textColor="#5B4B9E"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Registra las dosis que ya recibió. También puedes hacerlo más adelante."
                android:textColor="#6E7772"
                android:textSize="13sp" />

            <!-- Recuadro: Cada dosis cuenta -->
            <LinearLayout
                android:id="@+id/boxEstadoVacunas"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="18dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="22dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="Cartilla"
                    android:src="@drawable/icon_ajustes"
                    app:tint="#355847" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cada dosis cuenta"
                    android:textColor="#1F2421"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtContadorVacunasAgregadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Empieza a construir su cartilla digital."
                    android:textColor="#7A827D"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Botón Agregar vacuna -->
            <LinearLayout
                android:id="@+id/btnAgregarVacuna"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Agregar vacuna"
                    android:src="@drawable/icon_buscar"
                    app:tint="#1F2421" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Agregar vacuna"
                    android:textColor="#1F2421"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Aviso del perfil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#EFF4EE"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="Perfil"
                    android:src="@drawable/icon_usuario"
                    app:tint="#355847" />

                <TextView
                    android:id="@+id/txtInfoPerfil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:text="Perfil local de demostración · Usuario 1. Los identificadores y vínculos se generan al guardar. Sexo: 0 = macho, 1 = hembra."
                    android:textColor="#55615A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Botón Guardar mascota -->
            <Button
                android:id="@+id/btnGuardarMascota"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#355847"
                android:text="Guardar mascota"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="* Campos obligatorios · Guardado local en SQLite."
                android:textColor="#8A928D"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior -->
    <LinearLayout
        android:id="@+id/bottomNavAgregar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btnNavInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Inicio"
                android:src="@drawable/icon_home"
                app:tint="#4F5E56" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inicio"
                android:textColor="#4F5E56"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavAgregarActual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Agregar"
                android:src="@drawable/icon_buscar"
                app:tint="#E58C52" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Agregar"
                android:textColor="#B86B35"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavCuenta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Cuenta"
                android:src="@drawable/icon_usuario"
                app:tint="#4F5E56" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cuenta"
                android:textColor="#4F5E56"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>